<?xml version="1.0" encoding="utf-8"?>
<!-- 只允许 HTTPS，明文一律拒绝；证书锚点用系统信任库，不额外放行用户证书 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
