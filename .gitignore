# 本地密钥，绝对不要提交
# .env* 覆盖所有备份（.env.before-xxx 这种同样含密钥）
.env
.env*
# .env.example 是模板（不含密钥），要进仓库
!.env.example

# 后台管理存下来的配置（模型、key），同样不能提交
admin.json
admin.json.tmp

# Python 缓存
__pycache__/
*.py[cod]

# Agent 在沙箱里跑出来的临时产物
workspace/


# 知识库索引缓存，会自动重建
.cache/

# 虚拟环境，不进仓库
.venv/


# 知识库文档：自己放，仓库里不带
knowledge/

# 身份卡（人设包）：部署数据，仓库里只带自动生成的默认卡
personas/

# 覆盖率数据，别提交
.coverage
.coverage.*

# 用户自己的崩溃上报脚本/数据，不进仓库
crash_receiver.py
crashes/

# 只放服务器、不进仓库：APK、下载页、App 版本信息
deck/web/static/app/
deck/web/static/download.html
deck/web/static/app-version.json

# 技能包（只在服务器安装，不进仓库）
/skills/
/workspace/skills/
